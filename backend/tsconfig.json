{
  "compilerOptions": {
    // Target & Module
    "target": "ES2020", // Современный JS
    "module": "commonjs", // Для Node.js
    "rootDir": "./src", // Исходники в src/
    "outDir": "./dist", // Скомпилированные файлы в dist/

    // Типы
    "strict": true, // Включаем все строгие проверки
    "esModuleInterop": true, // Для импорта commonjs модулей
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true, // Не проверять сторонние типы
    "types": ["node"], // Типы Node.js

    // Карты исходников
    "sourceMap": true, // Для дебага
    "declaration": true, // Генерация .d.ts
    "declarationMap": true // Карта для .d.ts
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
